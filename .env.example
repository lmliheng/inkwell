# 复制成 .env 后填写。compose 只读这个文件，密钥不写进镜像。

# ---------- 运行必备 ----------
DB_NAME=fastweb_test
DB_USER=root
DB_PASSWORD=          # 必填：MySQL root 密码，首次建库就用它
JWT_SECRET=           # 必填：必须与 Node 版一致，否则已登录用户会掉线

# ---------- 端口 ----------
APP_PORT=7000         # 网关对外的端口，与原 Node 后端一致
MYSQL_PORT=3308       # MySQL 只绑 127.0.0.1，避开本机 3306
WEB_PORT=80           # 后台前端（apps/admin）对外的端口
BLOG_PORT=8080        # 博客前端（apps/blog）对外的端口，对外站点不设白名单
ADMIN_URL=http://127.0.0.1/   # 博客首页「进入后台」链接指向的地址，部署后改成后台的实际地址

# ---------- 后台来源白名单（分号或逗号分隔的 IP/CIDR）----------
# 后台只对名单内的来源开放，其余 403。默认只放行本机与 docker 私网段，
# 不加自己的出口 IP 的话，只有服务器本机能打开后台。
# 值里带分隔符，**建议加引号**：这个文件会被部署脚本 source 进 shell，不加引号会被当成命令。
ADMIN_ALLOW_HOSTS="127.0.0.1;::1;172.16.0.0/12"
# 例：ADMIN_ALLOW_HOSTS="127.0.0.1;::1;172.16.0.0/12;203.0.113.7;198.51.100.0/24"

# ---------- 跨域白名单（逗号分隔）----------
FRONTEND_URLS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8085,http://localhost:8085

# ---------- M1 已实做，留空即走原版的失败分支；填上就能真跑 ----------
# 阿里云 OSS（/upload/image，M2 的上传前置）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 邮件验证码（/email/send-code、/email/login）：填上即真发信
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# GitHub 登录（/auth/github、/auth/github/bind、/auth/github/callback）：填上即真走 GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# DeepSeek（文章 AI 摘要，M5）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
